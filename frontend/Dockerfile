FROM node:22-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

ARG API_URL_SERVER
ARG NEXT_PUBLIC_RECAPTCHA_SITE_KEY

ENV API_URL_SERVER=$API_URL_SERVER
ENV NEXT_PUBLIC_RECAPTCHA_SITE_KEY=$NEXT_PUBLIC_RECAPTCHA_SITE_KEY

RUN npm run build

EXPOSE 3000

CMD [ "npm","run","start" ]